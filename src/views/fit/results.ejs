<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title><%= title %></title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css"/>
</head>
<body class="bg-light">

<%- include("../partials/navbar") %>

<main class="container py-4">
  <% const top = (result && result.top) ? result.top : []; %>

  <div class="row justify-content-center">
    <div class="col-lg-10">

      <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
          <h2 class="fw-bold mb-0">Your Recommendations</h2>
          <div class="text-muted">
            Fit ID: <strong><%= result && result.savedFitId ? result.savedFitId : "" %></strong>
            <% if (result && result.mode) { %>
              <span class="ms-2 badge bg-info text-dark"><%= result.mode %></span>
            <% } %>
          </div>
        </div>

        <a class="btn btn-outline-secondary"
           href="/fit/step1?fitId=<%= result && result.savedFitId ? result.savedFitId : "" %>">
          Edit Inputs
        </a>
      </div>

      <div class="card shadow-sm mb-3">
        <div class="card-body">
          <h5 class="fw-semibold mb-2">Summary</h5>
          <div class="row g-2 small">
            <div class="col-md-6">
              <strong>Suggested size:</strong>
              <%= (result && result.summary) ? result.summary.recommendedSize : "" %>
            </div>
            <div class="col-md-6">
              <strong>Pick-up preference:</strong>
              <%= (result && result.summary) ? result.summary.pickupPreference : "" %>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-3">
        <% top.forEach(function(item, idx) { %>
          <%
            let badgeClass = "bg-secondary";
            let badgeText = "Top Pick";
            if (idx === 0) { badgeClass = "bg-success"; badgeText = "Best Match"; }

            // Ensure why is always an array
            let whyArr = [];
            if (Array.isArray(item.why)) whyArr = item.why;
            else if (typeof item.why === "string" && item.why.trim()) whyArr = [item.why];

            // Show only a short preview (no UI toggles)
            const headline = whyArr.length ? whyArr[0] : "No explanation available.";
            const bullets = (whyArr.length > 1) ? whyArr.slice(1, 6) : []; // max 5 bullets
          %>

          <div class="col-md-4">
            <div class="card shadow-sm h-100">
              <div class="card-body d-flex flex-column">

                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h5 class="fw-bold mb-0"><%= item.bat.brand %></h5>
                    <div class="text-muted"><%= item.bat.model %></div>
                  </div>
                  <span class="badge <%= badgeClass %>"><%= badgeText %></span>
                </div>

                <div class="mt-3 small">
                  <div><strong>Size:</strong> <%= item.bat.size_label %></div>
                  <div><strong>Weight:</strong> <%= item.bat.weight_g %>g</div>
                  <div><strong>Pick-up:</strong> <%= item.bat.pickup_rating %>/10</div>
                  <div><strong>Sweet spot:</strong> <%= item.bat.sweet_spot %></div>
                  <div><strong>Profile:</strong> <%= item.bat.profile %></div>
                  <div><strong>Handle:</strong> <%= item.bat.handle_shape %> / <%= item.bat.handle_length %></div>
                </div>

                <hr class="my-3"/>

                <div class="small">
                  <div class="fw-semibold mb-2"><%= headline %></div>

                  <% if (bullets.length) { %>
                    <ul class="mb-0">
                      <% bullets.forEach(function(r){ %>
                        <li><%= r %></li>
                      <% }); %>
                    </ul>
                  <% } else { %>
                    <div class="text-muted">No detail lines yet.</div>
                  <% } %>

                  <% if (whyArr.length > 6) { %>
                    <div class="text-muted mt-2">
                      + <%= (whyArr.length - 6) %> more notes (we can add a “Details” page later)
                    </div>
                  <% } %>
                </div>

              </div>
            </div>
          </div>
        <% }); %>
      </div>

      <div class="mt-4 d-flex gap-2">
        <a class="btn btn-success btn-lg" href="/fit/start">Start New Fit</a>
        <a class="btn btn-outline-secondary btn-lg" href="/api/bats" target="_blank">View Bats JSON</a>
      </div>

    </div>
  </div>
</main>

<%- include("../partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
