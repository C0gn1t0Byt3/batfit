<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css"/>
</head>
<body class="bg-light">

<%- include("../partials/navbar") %>

<main class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="fw-bold mb-0">Saved Fits</h2>
      <div class="text-muted">Review previous fittings and re-run recommendations.</div>
    </div>
    <a class="btn btn-success" href="/fit/start">New Fit</a>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-striped align-middle mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>Date</th>
            <th>Player</th>
            <th>Height</th>
            <th>Experience</th>
            <th>Best Match</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!fits || fits.length === 0) { %>
            <tr><td colspan="7" class="text-center text-muted py-4">No fits saved yet.</td></tr>
          <% } else { %>
            <% fits.forEach(function(f){ %>
              <tr>
                <td><strong>#<%= f.id %></strong></td>
                <td class="text-muted small"><%= (f.created_at || "").replace("T"," ").slice(0,19) %></td>
                <td><%= f.player_name || "-" %></td>
                <td><%= f.height_cm ? (f.height_cm + " cm") : "-" %></td>
                <td><%= f.experience || "-" %></td>
                <td>
                  <% if (f.best_brand || f.best_model) { %>
                    <span class="badge bg-success">Top</span>
                    <%= f.best_brand %> <%= f.best_model %>
                    <% if (f.best_size) { %><span class="text-muted">(<%= f.best_size %>)</span><% } %>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-primary" href="/fits/<%= f.id %>">View</a>
                  <a class="btn btn-sm btn-outline-secondary" href="/fit/step1?fitId=<%= f.id %>">Edit</a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
