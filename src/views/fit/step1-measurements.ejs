<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= title %>
  </title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<body class="bg-light">

  <%- include("../partials/navbar") %>

    <main class="container py-4">
      <div class="row justify-content-center">
        <div class="col-lg-9">
          <div class="card shadow-sm">
            <div class="card-body p-4">

              <h2 class="fw-bold">Measurements & Preferences</h2>
              <p class="text-muted">Fill this in to generate recommendations.</p>

              <form method="POST" action="/fit/results" class="mt-3">

                <!-- Keep fitId so Edit Inputs loads previous values -->
                <input type="hidden" name="fitId" value="<%= form.fitId || '' %>">

                <div class="row g-3">

                  <div class="col-md-4">
                    <label class="form-label">Height (cm)</label>
                    <input name="height_cm" type="number" class="form-control" required min="80" max="230"
                      value="<%= form.height_cm || '' %>">
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">Weight (kg)</label>
                    <input name="weight_kg" type="number" class="form-control" required min="20" max="200"
                      value="<%= form.weight_kg || '' %>">
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">Max hitting distance (m)</label>
                    <input name="max_distance_m" type="number" class="form-control" min="5" max="150"
                      value="<%= form.max_distance_m || '' %>">
                  </div>

                  <div class="col-md-6">
                    <label class="form-label">Hand size (cm) (optional)</label>
                    <div class="input-group">
                      <input name="hand_size_cm" type="number" step="0.1" class="form-control" min="10" max="30"
                        value="<%= form.hand_size_cm || '' %>">
                      <span class="input-group-text">cm</span>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label">Floor to wrist length (cm) (optional)</label>
                    <div class="input-group">
                      <input name="floor_to_wrist_cm" type="number" step="0.1" class="form-control" min="30" max="130"
                        value="<%= form.floor_to_wrist_cm || '' %>">
                      <span class="input-group-text">cm</span>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">Ideal shot type</label>
                    <select name="shot_type" class="form-select" required>
                      <% enums.SHOT_TYPES.forEach(function(v){ %>
                        <option value="<%= v %>" <%=(form.shot_type===v ? "selected" : "" ) %>>
                          <%= v.replaceAll("_"," ") %>
                      </option>
                    <% }); %>
                  </select>
                </div>

                <div class=" col-md-4">
                            <label class="form-label">Playing conditions</label>
                            <select name="conditions" class="form-select" required>
                              <% enums.CONDITIONS.forEach(function(v){ %>
                                <option value="<%= v %>" <%=(form.conditions===v ? "selected" : "" ) %>>
                                  <%= v.replaceAll("_"," ") %>
                      </option>
                    <% }); %>
                  </select>
                </div>

                <div class=" col-md-4">
                                    <label class="form-label">Preferred footwork</label>
                                    <select name="footwork" class="form-select" required>
                                      <% enums.FOOTWORK.forEach(function(v){ %>
                                        <option value="<%= v %>" <%=(form.footwork===v ? "selected" : "" ) %>>
                                          <%= v.replaceAll("_"," ") %>
                      </option>
                    <% }); %>
                  </select>
                </div>

                <div class=" col-md-6">
                                            <label class="form-label">Batting style</label>
                                            <select name="batter_style" class="form-select" required>
                                              <% enums.BATTER_STYLE.forEach(function(v){ %>
                                                <option value="<%= v %>" <%=(form.batter_style===v ? "selected" : "" )
                                                  %>>
                                                  <%= v.replaceAll("_"," ") %>
                      </option>
                    <% }); %>
                  </select>
                </div>

                <!-- ✅ Brand filter (DB driven, no hardcoding) -->
                <div class=" col-md-6">
                                                    <label class="form-label">Preferred brand (optional)</label>
                                                    <select class="form-select" name="brand_filter">
                                                      <option value="any" <%=(!form.brand_filter ||
                                                        form.brand_filter==="any" ) ? "selected" : "" %>>
                                                        Any brand
                                                      </option>

                                                      <% (brands || []).forEach(function(b) { %>
                                                        <option value="<%= b %>" <%=(form.brand_filter===b) ? "selected"
                                                          : "" %>>
                                                          <%= b %>
                                                        </option>
                                                        <% }) %>
                                                    </select>
                                                    <div class="form-text">Optional: restrict recommendations to a
                                                      single brand.</div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label">Experience</label>
                    <select name="experience" class="form-select" required>
                      <% enums.EXPERIENCE.forEach(function(v){ %>
                        <option value="<%= v %>" <%=(form.experience===v ? "selected" : "" ) %>>
                          <%= v.replaceAll("_"," ") %>
                      </option>
                    <% }); %>
                  </select>
                </div>

<hr class=" my-4" />

                          <h5 class="fw-semibold mb-2">Wagon Wheel (optional)</h5>
                          <p class="text-muted small mb-2">
                            Click where you hit the ball. Toggle Ground/Aerial. This will refine the recommendations.
                          </p>

                          <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                            <div class="btn-group" role="group" aria-label="Shot type">
                              <button type="button" id="shotTypeGround"
                                class="btn btn-outline-dark btn-sm active">Ground</button>
                              <button type="button" id="shotTypeAerial"
                                class="btn btn-outline-dark btn-sm">Aerial</button>
                            </div>

                            <button type="button" id="shotUndo" class="btn btn-outline-secondary btn-sm">Undo</button>
                            <button type="button" id="shotClear" class="btn btn-outline-danger btn-sm">Clear</button>

                            <div class="ms-auto small">
                              Ground: <strong id="groundCount">0</strong> |
                              Aerial: <strong id="aerialCount">0</strong> |
                              Total: <strong id="totalCount">0</strong>
                            </div>
                          </div>

                          <div class="card shadow-sm mt-2">
                            <div class="card-body">
                              <div style="max-width:520px;">
                                <canvas id="wagonWheelCanvas" width="520" height="520"
                                  style="width:100%; height:auto; border:1px solid #dee2e6; border-radius:12px;"></canvas>
                              </div>
                            </div>
                          </div>

                          <!-- value posted with the form -->
                          <input type="hidden" id="shotMapJson" name="shot_map_json"
                            value="<%= (form && form.shot_map_json) ? form.shot_map_json : '[]' %>" />

                          <!-- wagonWheel.js uses this id for autosave when editing -->
                          <input type="hidden" id="fitId" value="<%= form.fitId || '' %>">



                  </div>

                  <div class=" d-flex gap-2 mt-4">
                    <button class="btn btn-success btn-lg" type="submit">Get Recommendations</button>
                    <a class="btn btn-outline-secondary btn-lg" href="/">Cancel</a>
                  </div>

              </form>

            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("../partials/footer") %>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
      <script src="/js/wagonWheel.js"></script>

</body>

</html>