<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= title %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<body class="bg-light">
  <%- include("../partials/navbar") %>

    <main class="container py-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h2 class="fw-bold mb-0">Upload Bats CSV</h2>
          <div class="text-muted">Upserts by (tenant_id, brand, model, size_label)</div>
        </div>
        <a class="btn btn-outline-secondary" href="/admin/bats">Back to Bats</a>
      </div>

      <% if (errors && errors.length) { %>
        <div class="alert alert-danger">
          <div class="fw-semibold mb-2">Fix these issues:</div>
          <ul class="mb-0">
            <% errors.slice(0, 10).forEach(e=> { %><li>
                <%= e %>
              </li>
              <% }) %>
          </ul>
          <% if (errors.length> 10) { %>
            <div class="small text-muted mt-2">Showing first 10 of <%= errors.length %>
            </div>
            <% } %>
        </div>
        <% } %>

          <% if (stats) { %>
            <div class="alert alert-success">
              Imported <strong>
                <%= stats.total %>
              </strong> rows.
              New: <strong>
                <%= stats.wouldInsert %>
              </strong>,
              Updated: <strong>
                <%= stats.wouldUpdate %>
              </strong>
            </div>
            <% } %>


              <div class="card shadow-sm mb-3">
                <div class="card-body">
                  <form method="POST" action="/admin/bats/upload" enctype="multipart/form-data">
                    <div class="mb-3">
                      <label class="form-label fw-semibold">CSV File</label>
                      <input class="form-control" type="file" name="csvfile" accept=".csv" required>
                      <div class="form-text">
                        Required headers: brand, model, size_label, weight_g, pickup_rating, sweet_spot, profile,
                        handle_shape, handle_length, bow, notes, image_url
                      </div>
                    </div>
                    <button class="btn btn-primary">Upload & Import</button>
                  </form>
                </div>
              </div>

              <% if (preview && preview.length) { %>
                <div class="card shadow-sm">
                  <div class="card-body">
                    <h5 class="fw-semibold">Preview (first <%= preview.length %> rows)</h5>
                    <div class="table-responsive">
                      <table class="table table-sm table-striped align-middle">
                        <thead>
                          <tr>
                            <th>Brand</th>
                            <th>Model</th>
                            <th>Size</th>
                            <th>Weight</th>
                            <th>Pick-up</th>
                            <th>Sweet spot</th>
                            <th>Profile</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% preview.forEach(r=> { %>
                            <tr>
                              <td>
                                <%= r.brand %>
                              </td>
                              <td>
                                <%= r.model %>
                              </td>
                              <td>
                                <%= r.size_label %>
                              </td>
                              <td>
                                <%= r.weight_g ?? "" %>
                              </td>
                              <td>
                                <%= r.pickup_rating ?? "" %>
                              </td>
                              <td>
                                <%= r.sweet_spot %>
                              </td>
                              <td>
                                <%= r.profile %>
                              </td>
                            </tr>
                            <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
                <% } %>
    </main>

    <%- include("../partials/footer") %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>