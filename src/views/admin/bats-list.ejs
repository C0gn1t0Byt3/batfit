<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= title %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css" />
</head>

<body class="bg-light">
  <%- include("../partials/navbar") %>

    <form method="POST" action="/admin/logout" class="d-inline">
      <button class="btn btn-outline-secondary btn-sm">Logout</button>
    </form>

    <main class="container py-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h2 class="fw-bold mb-0">Bats Catalogue</h2>
          <div class="text-muted">
            <%= bats.length %> bats loaded
          </div>
        </div>
        <div class="d-flex gap-2">
          <a class="btn btn-primary" href="/admin/bats/upload">Upload CSV</a>
          <form method="POST" action="/admin/bats/clear" onsubmit="return confirm('Delete ALL bats for this tenant?');">
            <button class="btn btn-outline-danger">Clear Tenant</button>
          </form>
          <a class="btn btn-outline-primary" href="/admin/bats/download">Download CSV</a>
        </div>
      </div>

      <form class="card shadow-sm mb-3" method="GET" action="/admin/bats">
        <div class="card-body">
          <div class="row g-2 align-items-end">
            <div class="col-md-4">
              <label class="form-label">Search</label>
              <input class="form-control" name="q" value="<%= (filters && filters.q) ? filters.q : '' %>"
                placeholder="Brand or model...">
            </div>

            <div class="col-md-3">
              <label class="form-label">Brand</label>
              <select class="form-select" name="brand">
                <option value="">All</option>
                <% (options?.brands || []).forEach(b=> { %>
                  <option value="<%= b %>" <%=(filters?.brand===b ? "selected" : "" ) %>><%= b %>
                  </option>
                  <% }) %>
              </select>
            </div>

            <div class="col-md-3">
              <label class="form-label">Profile</label>
              <select class="form-select" name="profile">
                <option value="">All</option>
                <% (options?.profiles || []).forEach(p=> { %>
                  <option value="<%= p %>" <%=(filters?.profile===p ? "selected" : "" ) %>><%= p %>
                  </option>
                  <% }) %>
              </select>
            </div>

            <div class="col-md-2">
              <label class="form-label">Sweet spot</label>
              <select class="form-select" name="sweet_spot">
                <option value="">All</option>
                <% (options?.sweetSpots || []).forEach(s=> { %>
                  <option value="<%= s %>" <%=(filters?.sweet_spot===s ? "selected" : "" ) %>><%= s %>
                  </option>
                  <% }) %>
              </select>
            </div>

            <div class="col-12 d-flex gap-2 mt-2">
              <button class="btn btn-primary">Apply</button>
              <a class="btn btn-outline-secondary" href="/admin/bats">Reset</a>
            </div>
          </div>
        </div>
      </form>


      <div class="card shadow-sm">
        <div class="table-responsive">
          <table class="table table-striped align-middle mb-0">
            <thead>
              <tr>
                <th>Brand</th>
                <th>Model</th>
                <th>Size</th>
                <th>Weight (g)</th>
                <th>Pick-up</th>
                <th>Sweet spot</th>
                <th>Profile</th>
              </tr>
            </thead>
            <tbody>
              <% bats.forEach(b=> { %>
                <tr>
                  <td>
                    <%= b.brand %>
                  </td>
                  <td>
                    <%= b.model %>
                  </td>
                  <td>
                    <%= b.size_label %>
                  </td>
                  <td>
                    <%= b.weight_g ?? "" %>
                  </td>
                  <td>
                    <%= b.pickup_rating ?? "" %>
                  </td>
                  <td>
                    <%= b.sweet_spot %>
                  </td>
                  <td>
                    <%= b.profile %>
                  </td>
                </tr>
                <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <%- include("../partials/footer") %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>