<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css"/>
</head>
<body class="bg-light">
<%- include("../partials/navbar") %>

<main class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="fw-bold mb-0">Bats Catalogue</h2>
      <div class="text-muted"><%= bats.length %> bats loaded</div>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-primary" href="/admin/bats/upload">Upload CSV</a>
      <form method="POST" action="/admin/bats/clear" onsubmit="return confirm('Delete ALL bats for this tenant?');">
        <button class="btn btn-outline-danger">Clear Tenant</button>
      </form>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-striped align-middle mb-0">
        <thead>
          <tr>
            <th>Brand</th><th>Model</th><th>Size</th><th>Weight (g)</th><th>Pick-up</th><th>Sweet spot</th><th>Profile</th>
          </tr>
        </thead>
        <tbody>
          <% bats.forEach(b => { %>
            <tr>
              <td><%= b.brand %></td>
              <td><%= b.model %></td>
              <td><%= b.size_label %></td>
              <td><%= b.weight_g ?? "" %></td>
              <td><%= b.pickup_rating ?? "" %></td>
              <td><%= b.sweet_spot %></td>
              <td><%= b.profile %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
